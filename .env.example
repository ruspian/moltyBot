# Copy this file to .env and fill in your own values.
# NEVER commit .env to git — it contains your live API key.

# Required — your Claw Royale agent API key (mr_live_...)
CLAW_API_KEY=mmr_live_ttNyEM_LBHo-x-yJaSEfpqUbyLmFAftU

# Optional — clawroyale.ai and moltyroyale.com are aliases for the same
# backend (cdn.clawroyale.ai == cdn.moltyroyale.com). Leave default unless
# you have a specific reason to change it.
CLAW_HOST=cdn.clawroyale.ai

# Optional — "auto" (prefer paid when ready, else free), "free", or "paid"
CLAW_ENTRY_TYPE=auto

# Optional — log verbosity: DEBUG, INFO, WARNING, ERROR
CLAW_LOG_LEVEL=INFO

# Optional — tuning (seconds)
CLAW_STATE_POLL_INTERVAL=5
CLAW_RECONNECT_MIN_DELAY=1
CLAW_RECONNECT_MAX_DELAY=30
CLAW_INTER_GAME_DELAY=3
